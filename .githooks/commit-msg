#!/bin/sh
# Retire toute attribution IA du message de commit (règle d'équipe :
# Claude n'est jamais collaborateur du projet).
# POSIX uniquement (grep -E, awk) : marche sur macOS (BSD), Linux et Git for Windows.
msg_file="$1"
tmp="$msg_file.tmp.$$"

grep -v -i -E \
  -e '^[[:space:]]*co-authored-by:.*(claude|anthropic)' \
  -e 'generated with \[?claude' \
  -e 'noreply@anthropic\.com' \
  "$msg_file" | awk '
    { lines[NR] = $0 }
    END {
      last = NR
      while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
      for (i = 1; i <= last; i++) print lines[i]
    }' > "$tmp"
mv "$tmp" "$msg_file"

if ! grep -q -v -E '^[[:space:]]*(#|$)' "$msg_file"; then
  echo "commit-msg: message vide après nettoyage." >&2
  exit 1
fi
exit 0
